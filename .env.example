# ============================================================================
# SPILLTRACE — environment configuration
# Copy to .env and fill in.  NEVER commit .env.  (CON-004, NFR-007)
# Every variable consumed by the browser MUST be prefixed NEXT_PUBLIC_ and must
# never contain a credential.
# ============================================================================

# ---- general -------------------------------------------------------------
SPILLTRACE_ENV=development          # development | staging | production
SPILLTRACE_LOG_LEVEL=INFO
SPILLTRACE_VERSION=0.1.0

# ---- security (REQUIRED — no defaults are provided in code) ---------------
# generate with:  openssl rand -hex 32
SPILLTRACE_SECRET_KEY=change-me-openssl-rand-hex-32
SPILLTRACE_ACCESS_TOKEN_TTL_SECONDS=900
SPILLTRACE_REFRESH_TOKEN_TTL_SECONDS=604800
SPILLTRACE_CORS_ORIGINS=http://localhost:3000

# ---- database ------------------------------------------------------------
POSTGRES_USER=spilltrace
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=spilltrace
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ---- redis ---------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# ---- object storage (MinIO locally, S3 in production) --------------------
S3_ENDPOINT_URL=http://minio:9000
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=spilltrace
S3_SECRET_KEY=change-me-local-only
S3_BUCKET=spilltrace
S3_REGION=us-east-1

# ---- adapter selection ---------------------------------------------------
# fixture|cdse , synthetic|cmems , synthetic|aisstream , analytical|openoil ,
# analytical|unet , local|s3
SPILLTRACE_SATELLITE_PROVIDER=fixture
SPILLTRACE_ENVIRONMENT_PROVIDER=synthetic
SPILLTRACE_AIS_PROVIDER=synthetic
SPILLTRACE_DRIFT_ENGINE=analytical
SPILLTRACE_SEGMENTATION_MODEL=analytical
SPILLTRACE_STORAGE_PROVIDER=s3

# ---- Copernicus Data Space (Sentinel-1)  — SERVER SIDE ONLY --------------
CDSE_USERNAME=
CDSE_PASSWORD=
CDSE_CLIENT_ID=cdse-public

# ---- Copernicus Marine (wind/current)  — SERVER SIDE ONLY ----------------
COPERNICUSMARINE_SERVICE_USERNAME=
COPERNICUSMARINE_SERVICE_PASSWORD=

# ---- AISStream  — SERVER SIDE ONLY (never reaches the browser) -----------
AISSTREAM_API_KEY=

# ---- pipeline limits -----------------------------------------------------
SPILLTRACE_MAX_AOI_KM2=250000
SPILLTRACE_MAX_TIME_WINDOW_DAYS=30
SPILLTRACE_JOB_MAX_ATTEMPTS=3
SPILLTRACE_WORKER_CONCURRENCY=2

# ---- frontend (public — safe to ship to the browser) ---------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_MAP_STYLE_URL=/map-style.json
NEXT_PUBLIC_APP_NAME=SPILLTRACE
