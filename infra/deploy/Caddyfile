# SPILLTRACE edge: one public origin for the browser.
#   /api/*, /health*, /docs*, /openapi.json, /redoc*  ->  FastAPI  (api:8000)
#   everything else                                   ->  Next.js  (frontend:3000)
#
# Two modes, chosen entirely by /opt/spilltrace/.env (infra/deploy/enable-https.sh
# switches between them; no image rebuild is needed because the frontend is built
# same-origin):
#
#   HTTP   SITE_ADDRESS=":80"
#          Plain HTTP on the instance IP. SPILLTRACE_ENV must stay "staging": the
#          refresh cookie is Secure in production and cannot be set over HTTP.
#
#   HTTPS  SITE_ADDRESS="18-212-85-28.sslip.io"      (or a real domain)
#          REDIRECT_ADDRESS="http://18.212.85.28"      (people who type the bare IP)
#          PUBLIC_URL="https://18-212-85-28.sslip.io"
#          Caddy obtains and renews a Let's Encrypt certificate by itself (HTTP-01 on
#          port 80, TLS-ALPN on 443) and redirects HTTP to HTTPS. Certificates live
#          in the caddy-data volume, so restarts do not re-issue them.

{
	admin off
}

(spilltrace) {
	encode zstd gzip

	# Scene uploads are whole SAR products.
	request_body {
		max_size 2GB
	}

	@api path /api/* /health /health/* /docs /docs/* /openapi.json /redoc /redoc/*
	handle @api {
		reverse_proxy api:8000
	}

	handle {
		reverse_proxy frontend:3000
	}

	log {
		output stdout
		format console
	}
}

{$SITE_ADDRESS} {
	import spilltrace
}

# HTTPS mode only: a visitor who types the bare IP gets the named site. A
# certificate cannot be issued for the IP, so it must not serve the app itself.
# In HTTP mode this block binds a name that never resolves and is inert.
{$REDIRECT_ADDRESS:http://redirect.invalid} {
	redir {$PUBLIC_URL:http://localhost}{uri} permanent
}
